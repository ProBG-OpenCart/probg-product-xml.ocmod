{{ header }}{{ column_left }}
<div id="content">
 <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-feed" class="btn btn-primary"><i class="fa fa-save"></i></button> <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
 <div class="container-fluid">{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
  <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3></div><div class="panel-body">
   <form action="{{ action }}" method="post" id="form-feed" class="form-horizontal">
    <div class="form-group required"><label class="col-sm-3 control-label">{{ entry_name }}</label><div class="col-sm-9"><input name="name" value="{{ name }}" class="form-control" />{% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}</div></div>
    <div class="form-group required"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_code }}">{{ entry_code }}</span></label><div class="col-sm-9"><input name="code" value="{{ code }}" placeholder="manicure-products" class="form-control" />{% if error_code %}<div class="text-danger">{{ error_code }}</div>{% endif %}</div></div>
    <div class="form-group"><label class="col-sm-3 control-label">{{ entry_status }}</label><div class="col-sm-9"><select name="status" class="form-control"><option value="1" {% if status %}selected{% endif %}>{{ text_enabled }}</option><option value="0" {% if not status %}selected{% endif %}>{{ text_disabled }}</option></select></div></div>
    <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_feed_categories }}">{{ entry_feed_categories }}</span></label><div class="col-sm-9"><input type="text" id="input-category" class="form-control" placeholder="{{ entry_category }}" /><div id="feed-categories" class="well well-sm" style="height:150px;overflow:auto;margin-top:10px">{% for category in categories_selected %}<div id="feed-category{{ category.category_id }}"><i class="fa fa-minus-circle"></i> {{ category.name }}<input type="hidden" name="category_ids[]" value="{{ category.category_id }}" /></div>{% endfor %}</div></div></div>
    <div class="form-group"><label class="col-sm-3 control-label">{{ entry_feed_urls }}</label><div class="col-sm-9">
      <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ help_htaccess }}
        <p style="margin-top:10px"><strong>{{ text_htaccess_rule }}</strong></p>
        <div class="input-group"><input type="text" value="{{ htaccess_rule }}" class="form-control" readonly><span class="input-group-btn"><button type="button" class="btn btn-default btn-copy" data-copy="{{ htaccess_rule|e('html_attr') }}"><i class="fa fa-copy"></i></button></span></div>
        {% if feed_url %}<p style="margin-top:15px"><strong>{{ text_direct_url }}</strong></p><div class="input-group"><input type="text" value="{{ feed_url }}" class="form-control" readonly><span class="input-group-btn"><a href="{{ feed_url }}" target="_blank" class="btn btn-default"><i class="fa fa-external-link"></i></a></span></div>{% endif %}
        {% if feed_url_seo %}<p style="margin-top:10px"><strong>{{ text_seo_url }}</strong></p><div class="input-group"><input type="text" value="{{ feed_url_seo }}" class="form-control" readonly><span class="input-group-btn"><a href="{{ feed_url_seo }}" target="_blank" class="btn btn-default"><i class="fa fa-external-link"></i></a></span></div>{% endif %}
      </div>
    </div></div>
    <fieldset><legend>{{ text_xml_fields }}</legend>
    {% for field in fields %}<div class="form-group"><label class="col-sm-3 control-label">{{ attribute(_context, 'entry_' ~ field) }}</label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="settings[{{ field }}]" value="1" {% if settings[field] %}checked{% endif %}> {{ text_yes }}</label><label class="radio-inline"><input type="radio" name="settings[{{ field }}]" value="0" {% if not settings[field] %}checked{% endif %}> {{ text_no }}</label></div></div>{% endfor %}
    </fieldset>
   </form>
  </div></div>
 </div>
</div>
<script>
$('#input-category').autocomplete({source:function(request,response){$.ajax({url:'index.php?route=extension/feed/product_xml/autocomplete&user_token={{ user_token }}&filter_name='+encodeURIComponent(request),dataType:'json',success:function(json){response($.map(json,function(item){return {label:item.name,value:item.category_id};}));}});},select:function(item){$('#input-category').val('');$('#feed-category'+item.value).remove();$('#feed-categories').append('<div id="feed-category'+item.value+'"><i class="fa fa-minus-circle"></i> '+item.label+'<input type="hidden" name="category_ids[]" value="'+item.value+'" /></div>');return false;}});
$('#feed-categories').on('click','.fa-minus-circle',function(){$(this).parent().remove();});
$('.btn-copy').on('click', function(){var input=$('<input>');$('body').append(input);input.val($(this).data('copy')).select();document.execCommand('copy');input.remove();});
</script>{{ footer }}
